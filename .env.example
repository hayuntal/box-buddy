# Supabase (from `supabase start`, or your hosted project settings)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vision provider: "stub" (no API calls, fixture data) or "anthropic"
VISION_PROVIDER=stub
ANTHROPIC_API_KEY=

# Signs the session cookie on the in-process adapter. Required in production;
# in development a fixed dev value is used when this is empty.
AUTH_SECRET=
